# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
# Port lives in one place: scripts/server-port.mjs (DEFAULT_PORT) or set PORT here.
# npm scripts (dev/start) resolve it via scripts/dev-server.mjs / scripts/start-server.mjs,
# so never hard-code a port in package.json — the `${PORT:-...}` syntax breaks on Windows cmd.
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20127
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20127
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Free-lane egress identity / session pairing.
# auto   = detect the direct public IP only when a direct egress is cooling or a 429 occurs
# always = detect it proactively
# off    = never call the detector (unconfirmed direct egress fails open)
# EGRESS_PROBE_MODE=auto
# EGRESS_PROBE_URL=https://api64.ipify.org?format=json
# EGRESS_PROBE_TIMEOUT_MS=2500
# EGRESS_IP_CACHE_TTL_MS=600000
# EGRESS_IP_STALE_TTL_MS=3600000
# EGRESS_DIRECT_RECHECK_MS=15000
# EGRESS_MAX_COOLDOWN_MS=86400000

# OpenCode free-lane transport.
# auto = forward through a local Bun sidecar when the binary is available,
#        falling back to the Node fetch path on any transport failure
# off  = always use the Node fetch path
# OPENCODE_TRANSPORT=auto
# OPENCODE_BUN_BIN=bun
# OPENCODE_TRANSPORT_SCRIPT=/app/scripts/opencode-transport.mjs
# OPENCODE_TRANSPORT_READY_TIMEOUT_MS=8000
# OPENCODE_TRANSPORT_BACKOFF_MS=300000

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router

# Proactive request pacing for web-cookie (browser-session) providers
# (grok-web, chatgpt-web, deepseek-web, intern-web, ...).
#
# A web session is a human account on a website: its anti-bot scores "does this
# look like a person typing". An unbounded parallel worker pool reads as
# automation and gets the account throttled, challenged, or banned — and a
# banned web session cannot be re-minted by waiting for a quota reset the way a
# rate-limited API key can. These limits are the proactive half; the existing
# 429 handling is the reactive half.
#
# Pacing is per CONNECTION, so separate accounts never share a budget and
# account failover still works. Browser-driven providers (gemini-web, muse-web,
# qwen-web, chatglm-web, uc-web) are exempt — they already wait on the DOM.
#
# WEB_THROTTLE_ENABLED=false disables pacing entirely; the individual numbers
# below are the knobs when it is on. Defaults shown.
# WEB_THROTTLE_MIN_INTERVAL_MS=1200
# WEB_THROTTLE_MAX_CONCURRENT=2
# WEB_THROTTLE_BURST=5
# WEB_THROTTLE_RESET_MS=10000
# How long a request may queue for one account before it gives up and lets the
# combo move on. Keep this well under your patience for a stalled member.
# WEB_THROTTLE_MAX_WAIT_MS=5000
# WEB_THROTTLE_PENALTY_MS=60000
# WEB_THROTTLE_MAX_PENALTY_LEVEL=4
# WEB_THROTTLE_MAX_PENALTY_INTERVAL_MS=30000
